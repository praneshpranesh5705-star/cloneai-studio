# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values.
# On Vercel, set these under Project Settings -> Environment Variables.
# NEVER commit .env.local. NEVER give a secret a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# --- Required: Supabase (Project Settings -> API) --------------------------
# The project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon / publishable key. This is safe in the browser: Row Level Security
# is what protects the data. Do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# --- Optional: model providers --------------------------------------------
# Add at least one to leave demo mode. The app detects which are present.
# Server-only. These must never be prefixed with NEXT_PUBLIC_.

OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Force a default provider when several are configured.
# One of: openai | openrouter | anthropic | gemini
# Leave blank to use the first configured provider.
AI_PROVIDER=

# --- Optional: Avatar Studio ------------------------------------------------
# Avatar images work with GEMINI_API_KEY or OPENAI_API_KEY (either one).
# Talking video needs GEMINI_API_KEY with paid-tier access.

# Force the image provider when both keys are set: gemini | openai
AVATAR_IMAGE_PROVIDER=

# Override the models. Defaults:
#   gemini-nano-banana-2.1 (image) / gpt-image-2.5-sunburst (image)
#   gemini-omni-1.2-flash (video)
AVATAR_IMAGE_MODEL=
AVATAR_VIDEO_MODEL=

# --- Optional: Website Builder model override ------------------------------
# Not needed: the Website Builder uses whichever provider above is configured.
# Set this only to pick a different model for generated pages than for chat.
# Example: gpt-4o
WEBSITE_MODEL=
